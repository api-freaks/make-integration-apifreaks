{
  "url": "https://api.apifreaks.com/v1.0/credits/usage/info",
  "method": "GET",
  "headers": {
    "X-apiKey": "{{parameters.apiKey}}"
  },
  "response": {
    "error": {
      "message": "[{{statusCode}}] Invalid API key"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.X-apiKey"
    ]
  }
}
