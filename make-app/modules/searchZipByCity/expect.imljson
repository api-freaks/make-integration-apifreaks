[
  {
    "name": "city",
    "label": "City",
    "type": "text",
    "required": true,
    "help": "Name of the city in which we want to find zipcodes in."
  },
  {
    "name": "country",
    "label": "Country",
    "type": "text",
    "required": true,
    "help": "Country code in ISO 3166-1 alpha-2 format."
  },
  {
    "name": "stateName",
    "label": "State name",
    "type": "text",
    "required": false,
    "help": "Name of the state or province associated with the country."
  },
  {
    "name": "limit",
    "label": "Limit",
    "type": "uinteger",
    "default": 10,
    "help": "Maximum number of results to return."
  }
]
