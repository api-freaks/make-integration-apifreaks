{
  "url": "/v1.0/ocr/predict",
  "method": "POST",
  "qs": {
    "url": "{{parameters.url}}",
    "model": "{{parameters.model}}",
    "page_range": "{{parameters.page_range}}",
    "zone": "{{parameters.zone}}",
    "new_line": "{{parameters.new_line}}"
  },
  "body": {
    "url": "{{parameters.url}}",
    "model": "{{parameters.model}}",
    "page_range": "{{parameters.page_range}}",
    "zone": "{{parameters.zone}}",
    "new_line": "{{parameters.new_line}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
