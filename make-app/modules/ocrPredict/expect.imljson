[
  {
    "name": "url",
    "label": "URL",
    "type": "text",
    "required": false,
    "help": "URL of the image or PDF (required if `file` not provided)"
  },
  {
    "name": "model",
    "label": "Model",
    "type": "select",
    "required": true,
    "help": "OCR model to use.",
    "options": [
      {
        "label": "mini-ocr-v1",
        "value": "mini-ocr-v1"
      },
      {
        "label": "ocr-v1",
        "value": "ocr-v1"
      }
    ]
  },
  {
    "name": "pageRange",
    "label": "Page range",
    "type": "text",
    "required": false,
    "help": "Specify page range for multi-page PDFs (e.g., '1,3,5-10' or 'allpages'). **Note:** This parameter can only be used with .pdf file types."
  },
  {
    "name": "zone",
    "label": "Zone",
    "type": "text",
    "required": false,
    "help": "Define OCR zones using coordinates (top:left:height:width). Multiple zones can be defined using commas. Only available for model 'ocr-v1'. **Note:** This parameter cannot be used with .pdf and .zip file types as it can only be applied to single image queries."
  },
  {
    "name": "newLine",
    "label": "New line",
    "type": "select",
    "required": false,
    "help": "Set to 1 to split output text into individual lines (default: 0)",
    "options": [
      {
        "label": "0",
        "value": 0
      },
      {
        "label": "1",
        "value": 1
      }
    ]
  },
  {
    "name": "fileName",
    "label": "File name",
    "type": "filename",
    "required": false,
    "semantic": "file:name",
    "help": "Name of the file being uploaded."
  },
  {
    "name": "fileData",
    "label": "File",
    "type": "buffer",
    "required": false,
    "semantic": "file:data",
    "help": "Image, PDF, or ZIP to OCR. Provide this or a URL."
  }
]
