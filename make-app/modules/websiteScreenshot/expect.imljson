[
  {
    "name": "output",
    "label": "Output",
    "type": "select",
    "required": false,
    "help": "Output format for screenshot results",
    "options": [
      {
        "label": "json",
        "value": "json"
      },
      {
        "label": "image",
        "value": "image"
      }
    ]
  },
  {
    "name": "fileType",
    "label": "File type",
    "type": "select",
    "required": false,
    "help": "File type for screenshot output",
    "options": [
      {
        "label": "PNG",
        "value": "PNG"
      },
      {
        "label": "JPEG",
        "value": "JPEG"
      },
      {
        "label": "WEBP",
        "value": "WEBP"
      },
      {
        "label": "PDF",
        "value": "PDF"
      },
      {
        "label": "mp4",
        "value": "mp4"
      },
      {
        "label": "gif",
        "value": "gif"
      },
      {
        "label": "webm",
        "value": "webm"
      }
    ]
  },
  {
    "name": "url",
    "label": "URL",
    "type": "text",
    "required": true,
    "help": "URLs to capture screenshots of"
  },
  {
    "name": "width",
    "label": "Width",
    "type": "number",
    "required": false,
    "help": "Browser viewport width in pixels"
  },
  {
    "name": "height",
    "label": "Height",
    "type": "number",
    "required": false,
    "help": "Browser viewport height in pixels"
  },
  {
    "name": "fullPage",
    "label": "Full page",
    "type": "boolean",
    "required": false,
    "help": "Capture a full-page screenshot"
  },
  {
    "name": "fresh",
    "label": "Fresh",
    "type": "boolean",
    "required": false,
    "help": "Bypass cache and take a fresh screenshot"
  },
  {
    "name": "noCookieBanners",
    "label": "No cookie banners",
    "type": "boolean",
    "required": false,
    "help": "Remove cookie banners from the screenshot"
  },
  {
    "name": "enableCaching",
    "label": "Enable caching",
    "type": "boolean",
    "required": false,
    "help": "Enable caching for repeated requests"
  },
  {
    "name": "blockAds",
    "label": "Block ads",
    "type": "boolean",
    "required": false,
    "help": "Block advertisements on the page"
  },
  {
    "name": "blockChatWidgets",
    "label": "Block chat widgets",
    "type": "boolean",
    "required": false,
    "help": "Block chat widget scripts from loading"
  },
  {
    "name": "extractText",
    "label": "Extract text",
    "type": "boolean",
    "required": false,
    "help": "Extract visible text from the page"
  },
  {
    "name": "extractHtml",
    "label": "Extract HTML",
    "type": "boolean",
    "required": false,
    "help": "Extract HTML content of the page"
  },
  {
    "name": "destroyScreenshot",
    "label": "Destroy screenshot",
    "type": "boolean",
    "required": false,
    "help": "Auto-destroy screenshot after fetch"
  },
  {
    "name": "lazyLoad",
    "label": "Lazy load",
    "type": "boolean",
    "required": false,
    "help": "Enable lazy-loading content before screenshot"
  },
  {
    "name": "retina",
    "label": "Retina",
    "type": "boolean",
    "required": false,
    "help": "Capture screenshot in high-DPI (Retina) mode"
  },
  {
    "name": "darkMode",
    "label": "Dark mode",
    "type": "boolean",
    "required": false,
    "help": "Render page in dark mode"
  },
  {
    "name": "blockTracking",
    "label": "Block tracking",
    "type": "boolean",
    "required": false,
    "help": "Block common user-tracking scripts"
  },
  {
    "name": "enableIncognito",
    "label": "Enable incognito",
    "type": "boolean",
    "required": false,
    "help": "Enable private/incognito mode for browser session"
  },
  {
    "name": "omitBackground",
    "label": "Omit background",
    "type": "boolean",
    "required": false,
    "help": "Omit background color (transparent background)"
  },
  {
    "name": "thumbnailWidth",
    "label": "Thumbnail width",
    "type": "number",
    "required": false,
    "help": "Thumbnail width in pixels"
  },
  {
    "name": "adjustTop",
    "label": "Adjust top",
    "type": "number",
    "required": false,
    "help": "Adjust top in pixels"
  },
  {
    "name": "waitForEvent",
    "label": "Wait for event",
    "type": "select",
    "required": false,
    "help": "Wait for a specific load event before capturing the screenshot.",
    "options": [
      {
        "label": "load",
        "value": "load"
      },
      {
        "label": "domcontentloaded",
        "value": "domcontentloaded"
      },
      {
        "label": "networkidle",
        "value": "networkidle"
      }
    ]
  },
  {
    "name": "grayscale",
    "label": "Grayscale",
    "type": "number",
    "required": false,
    "help": "Range:0 to 100 for grayscale filter"
  },
  {
    "name": "delay",
    "label": "Delay",
    "type": "number",
    "required": false,
    "help": "How many milliseconds to wait before taking the screenshot"
  },
  {
    "name": "timeout",
    "label": "Timeout",
    "type": "number",
    "required": false,
    "help": "Maximum timeout in milliseconds. Defalut is `10,000`"
  },
  {
    "name": "ttl",
    "label": "TTL",
    "type": "number",
    "required": false,
    "help": "Number of seconds the screenshot should be cached"
  },
  {
    "name": "clipX",
    "label": "Clip x",
    "type": "number",
    "required": false,
    "help": "X position of the clipping rectangle in pixels"
  },
  {
    "name": "clipY",
    "label": "Clip y",
    "type": "number",
    "required": false,
    "help": "Y position of the clipping rectangle in pixels"
  },
  {
    "name": "clipWidth",
    "label": "Clip width",
    "type": "number",
    "required": false,
    "help": "Width of the clipping rectangle in pixels"
  },
  {
    "name": "clipHeight",
    "label": "Clip height",
    "type": "number",
    "required": false,
    "help": "Height of the clipping rectangle in pixels"
  },
  {
    "name": "cssUrl",
    "label": "CSS URL",
    "type": "text",
    "required": false,
    "help": "URL to CSS file"
  },
  {
    "name": "css",
    "label": "CSS",
    "type": "text",
    "required": false,
    "help": "Your custom CSS code"
  },
  {
    "name": "jsUrl",
    "label": "JS URL",
    "type": "text",
    "required": false,
    "help": "URL to JS file"
  },
  {
    "name": "js",
    "label": "JS",
    "type": "text",
    "required": false,
    "help": "Your JS code"
  },
  {
    "name": "blockJs",
    "label": "Block JS",
    "type": "boolean",
    "required": false,
    "help": "Block Scripts"
  },
  {
    "name": "blockStylesheets",
    "label": "Block stylesheets",
    "type": "boolean",
    "required": false,
    "help": "Block Stylesheets"
  },
  {
    "name": "blockImages",
    "label": "Block images",
    "type": "boolean",
    "required": false,
    "help": "Block Images"
  },
  {
    "name": "blockMedia",
    "label": "Block media",
    "type": "boolean",
    "required": false,
    "help": "Block Media"
  },
  {
    "name": "blockFont",
    "label": "Block font",
    "type": "boolean",
    "required": false,
    "help": "Block Fonts"
  },
  {
    "name": "blockTextTrack",
    "label": "Block text track",
    "type": "boolean",
    "required": false,
    "help": "Block Text Tracks"
  },
  {
    "name": "blockXhr",
    "label": "Block xhr",
    "type": "boolean",
    "required": false,
    "help": "Block XHR Requests"
  },
  {
    "name": "blockFetch",
    "label": "Block fetch",
    "type": "boolean",
    "required": false,
    "help": "Block Fetch Requests"
  },
  {
    "name": "blockEventSource",
    "label": "Block event source",
    "type": "boolean",
    "required": false,
    "help": "Block Event Source"
  },
  {
    "name": "blockWebSocket",
    "label": "Block web socket",
    "type": "boolean",
    "required": false,
    "help": "Block Web Sockets"
  },
  {
    "name": "blockManifest",
    "label": "Block manifest",
    "type": "boolean",
    "required": false,
    "help": "Block Manifest"
  },
  {
    "name": "blockSpecificRequests",
    "label": "Block specific requests",
    "type": "text",
    "required": false,
    "help": "Comma- or newline-separated list of specific requests to block. Each line and comma are treated as separate requests for processing. Example: https://example.com, https://example.js"
  },
  {
    "name": "blurSelector",
    "label": "Blur selector",
    "type": "array",
    "required": false,
    "help": "Comma-separated list of indexed CSS selectors to blur. Format: `index:<selector>`, e.g., `0:.banner,1:#ads`."
  },
  {
    "name": "removeSelector",
    "label": "Remove selector",
    "type": "array",
    "required": false,
    "help": "Comma-separated list of indexed CSS selectors to remove. Format: `index:<selector>`, e.g., `0:.banner,1:#ads`."
  },
  {
    "name": "resultFileName",
    "label": "Result file name",
    "type": "text",
    "required": false,
    "help": "Specify a meaningful & unique file name to easily identify the screenshot result. Avoid using spaces or special characters; use hyphens or underscores to separate words."
  },
  {
    "name": "scrollingScreenshot",
    "label": "Scrolling screenshot",
    "type": "boolean",
    "required": false,
    "help": "**`Scrolling Screenshot`**: Capture a long scrolling screenshot. When true, disable `fullPage` and `freshScreenshot`."
  },
  {
    "name": "scrollSpeed",
    "label": "Scroll speed",
    "type": "select",
    "required": false,
    "help": "Speed of scrolling during the screenshot.",
    "options": [
      {
        "label": "normal",
        "value": "normal"
      },
      {
        "label": "fast",
        "value": "fast"
      },
      {
        "label": "slow",
        "value": "slow"
      }
    ]
  },
  {
    "name": "scrollBack",
    "label": "Scroll back",
    "type": "boolean",
    "required": false,
    "help": "If true, the scroll will reverse back to the top after reaching the bottom."
  },
  {
    "name": "startImmediately",
    "label": "Start immediately",
    "type": "boolean",
    "required": false,
    "help": "If true, the scrolling capture will start immediately upon page load."
  },
  {
    "name": "multipleScrolling",
    "label": "Multiple scrolling",
    "type": "boolean",
    "required": false,
    "help": "If true, multiple scrolling screenshots will be taken at different viewport sizes."
  },
  {
    "name": "sizes",
    "label": "Sizes",
    "type": "array",
    "required": false,
    "help": "Comma-separated list of viewport sizes in the format index:XXw:YYh. Example: sizes=0:120w:300h,1:240w:500h"
  },
  {
    "name": "duration",
    "label": "Duration",
    "type": "number",
    "required": false,
    "help": "Duration in seconds for the scrolling capture. Acceptable range: 0 to 60 seconds."
  },
  {
    "name": "failOnError",
    "label": "Fail on error",
    "type": "boolean",
    "required": false,
    "help": "If true, returns an error when the target page responds with 4xx or 5xx status."
  },
  {
    "name": "longitude",
    "label": "Longitude",
    "type": "number",
    "required": false,
    "help": "Specify longitude for the browser Geolocation API."
  },
  {
    "name": "latitude",
    "label": "Latitude",
    "type": "number",
    "required": false,
    "help": "Specify latitude for the browser Geolocation API."
  },
  {
    "name": "proxy",
    "label": "Proxy",
    "type": "text",
    "required": false,
    "help": "Allows defining a proxy for the connection. Provide a JSON string with keys: server (include port number), username, and password."
  },
  {
    "name": "headers",
    "label": "Headers",
    "type": "text",
    "required": false,
    "help": "Custom HTTP headers to include as key=value pairs. Use a semicolon to separate multiple headers (e.g., key1=value1;key2=value2)."
  },
  {
    "name": "cookies",
    "label": "Cookies",
    "type": "text",
    "required": false,
    "help": "Cookies to include in the request before rendering. Supports single or multiple cookies. Example: cookie=value; otherCookie=otherValue;"
  },
  {
    "name": "scrollToElement",
    "label": "Scroll to element",
    "type": "text",
    "required": false,
    "help": "Scrolls the page to bring the specified CSS selector into view before capture."
  },
  {
    "name": "selector",
    "label": "Selector",
    "type": "text",
    "required": false,
    "help": "CSS selector to capture a specific element. Only that element is rendered."
  },
  {
    "name": "selectorToClick",
    "label": "Selector to click",
    "type": "text",
    "required": false,
    "help": "CSS selector for an element to click before capturing the screenshot."
  },
  {
    "name": "clickRecursion",
    "label": "Click recursion",
    "type": "number",
    "required": false,
    "help": "Number of times to click the selector (when set via selector_to_click). Default: 1."
  },
  {
    "name": "userAgent",
    "label": "User agent",
    "type": "text",
    "required": false,
    "help": "Custom User-Agent string sent in the request headers."
  },
  {
    "name": "acceptLanguages",
    "label": "Accept languages",
    "type": "text",
    "required": false,
    "help": "Sets the accepted languages for the HTTP request. Sent as the Accept-Language header."
  },
  {
    "name": "scrollDelay",
    "label": "Scroll delay",
    "type": "number",
    "required": false,
    "help": "Delay in milliseconds between scroll steps when lazy_load is enabled."
  },
  {
    "name": "customHtml",
    "label": "Custom HTML",
    "type": "text",
    "required": false,
    "help": "Custom HTML to render instead of loading a URL. Overrides the url option."
  },
  {
    "name": "imageQuality",
    "label": "Image quality",
    "type": "number",
    "required": false,
    "help": "Compression level for JPEG output (0–100). Lower = smaller file, higher = better quality. Only applies to JPEG."
  },
  {
    "name": "extractMarkdown",
    "label": "Extract markdown",
    "type": "boolean",
    "required": false,
    "help": "Extracts rendered page content as a structured .md (Markdown) file."
  },
  {
    "name": "getImageUrls",
    "label": "Get image URLs",
    "type": "boolean",
    "required": false,
    "help": "Extracts all image URLs from the rendered DOM and returns them in structured format."
  }
]
