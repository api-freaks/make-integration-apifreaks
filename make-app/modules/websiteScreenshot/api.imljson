{
  "url": "/v1.0/screenshot",
  "method": "GET",
  "qs": {
    "output": "{{parameters.output}}",
    "file_type": "{{parameters.file_type}}",
    "url": "{{parameters.url}}",
    "width": "{{parameters.width}}",
    "height": "{{parameters.height}}",
    "full_page": "{{parameters.full_page}}",
    "fresh": "{{parameters.fresh}}",
    "no_cookie_banners": "{{parameters.no_cookie_banners}}",
    "enable_caching": "{{parameters.enable_caching}}",
    "block_ads": "{{parameters.block_ads}}",
    "block_chat_widgets": "{{parameters.block_chat_widgets}}",
    "extract_text": "{{parameters.extract_text}}",
    "extract_html": "{{parameters.extract_html}}",
    "destroy_screenshot": "{{parameters.destroy_screenshot}}",
    "lazy_load": "{{parameters.lazy_load}}",
    "retina": "{{parameters.retina}}",
    "dark_mode": "{{parameters.dark_mode}}",
    "block_tracking": "{{parameters.block_tracking}}",
    "enable_incognito": "{{parameters.enable_incognito}}",
    "omit_background": "{{parameters.omit_background}}",
    "thumbnail_width": "{{parameters.thumbnail_width}}",
    "adjust_top": "{{parameters.adjust_top}}",
    "wait_for_event": "{{parameters.wait_for_event}}",
    "grayscale": "{{parameters.grayscale}}",
    "delay": "{{parameters.delay}}",
    "timeout": "{{parameters.timeout}}",
    "ttl": "{{parameters.ttl}}",
    "clip[x]": "{{parameters.clip[x]}}",
    "clip[y]": "{{parameters.clip[y]}}",
    "clip[width]": "{{parameters.clip[width]}}",
    "clip[height]": "{{parameters.clip[height]}}",
    "css_url": "{{parameters.css_url}}",
    "css": "{{parameters.css}}",
    "js_url": "{{parameters.js_url}}",
    "js": "{{parameters.js}}",
    "block_js": "{{parameters.block_js}}",
    "block_stylesheets": "{{parameters.block_stylesheets}}",
    "block_images": "{{parameters.block_images}}",
    "block_media": "{{parameters.block_media}}",
    "block_font": "{{parameters.block_font}}",
    "block_text_track": "{{parameters.block_text_track}}",
    "block_xhr": "{{parameters.block_xhr}}",
    "block_fetch": "{{parameters.block_fetch}}",
    "block_event_source": "{{parameters.block_event_source}}",
    "block_web_socket": "{{parameters.block_web_socket}}",
    "block_manifest": "{{parameters.block_manifest}}",
    "block_specific_requests": "{{parameters.block_specific_requests}}",
    "blur_selector": "{{parameters.blur_selector}}",
    "remove_selector": "{{parameters.remove_selector}}",
    "result_file_name": "{{parameters.result_file_name}}",
    "scrolling_screenshot": "{{parameters.scrolling_screenshot}}",
    "scroll_speed": "{{parameters.scroll_speed}}",
    "scroll_back": "{{parameters.scroll_back}}",
    "start_immediately": "{{parameters.start_immediately}}",
    "multiple_scrolling": "{{parameters.multiple_scrolling}}",
    "sizes": "{{parameters.sizes}}",
    "duration": "{{parameters.duration}}",
    "fail_on_error": "{{parameters.fail_on_error}}",
    "longitude": "{{parameters.longitude}}",
    "latitude": "{{parameters.latitude}}",
    "proxy": "{{parameters.proxy}}",
    "headers": "{{parameters.headers}}",
    "cookies": "{{parameters.cookies}}",
    "scroll_to_element": "{{parameters.scroll_to_element}}",
    "selector": "{{parameters.selector}}",
    "selector_to_click": "{{parameters.selector_to_click}}",
    "click_recursion": "{{parameters.click_recursion}}",
    "user_agent": "{{parameters.user_agent}}",
    "accept_languages": "{{parameters.accept_languages}}",
    "scroll_delay": "{{parameters.scroll_delay}}",
    "custom_html": "{{parameters.custom_html}}",
    "image_quality": "{{parameters.image_quality}}",
    "extract_markdown": "{{parameters.extract_markdown}}",
    "get_image_urls": "{{parameters.get_image_urls}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
