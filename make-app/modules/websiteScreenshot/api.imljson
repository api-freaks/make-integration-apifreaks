{
  "url": "/v1.0/screenshot",
  "method": "GET",
  "qs": {
    "output": "{{parameters.output}}",
    "file_type": "{{parameters.fileType}}",
    "url": "{{parameters.url}}",
    "width": "{{parameters.width}}",
    "height": "{{parameters.height}}",
    "full_page": "{{parameters.fullPage}}",
    "fresh": "{{parameters.fresh}}",
    "no_cookie_banners": "{{parameters.noCookieBanners}}",
    "enable_caching": "{{parameters.enableCaching}}",
    "block_ads": "{{parameters.blockAds}}",
    "block_chat_widgets": "{{parameters.blockChatWidgets}}",
    "extract_text": "{{parameters.extractText}}",
    "extract_html": "{{parameters.extractHtml}}",
    "destroy_screenshot": "{{parameters.destroyScreenshot}}",
    "lazy_load": "{{parameters.lazyLoad}}",
    "retina": "{{parameters.retina}}",
    "dark_mode": "{{parameters.darkMode}}",
    "block_tracking": "{{parameters.blockTracking}}",
    "enable_incognito": "{{parameters.enableIncognito}}",
    "omit_background": "{{parameters.omitBackground}}",
    "thumbnail_width": "{{parameters.thumbnailWidth}}",
    "adjust_top": "{{parameters.adjustTop}}",
    "wait_for_event": "{{parameters.waitForEvent}}",
    "grayscale": "{{parameters.grayscale}}",
    "delay": "{{parameters.delay}}",
    "timeout": "{{parameters.timeout}}",
    "ttl": "{{parameters.ttl}}",
    "clip[x]": "{{parameters.clipX}}",
    "clip[y]": "{{parameters.clipY}}",
    "clip[width]": "{{parameters.clipWidth}}",
    "clip[height]": "{{parameters.clipHeight}}",
    "css_url": "{{parameters.cssUrl}}",
    "css": "{{parameters.css}}",
    "js_url": "{{parameters.jsUrl}}",
    "js": "{{parameters.js}}",
    "block_js": "{{parameters.blockJs}}",
    "block_stylesheets": "{{parameters.blockStylesheets}}",
    "block_images": "{{parameters.blockImages}}",
    "block_media": "{{parameters.blockMedia}}",
    "block_font": "{{parameters.blockFont}}",
    "block_text_track": "{{parameters.blockTextTrack}}",
    "block_xhr": "{{parameters.blockXhr}}",
    "block_fetch": "{{parameters.blockFetch}}",
    "block_event_source": "{{parameters.blockEventSource}}",
    "block_web_socket": "{{parameters.blockWebSocket}}",
    "block_manifest": "{{parameters.blockManifest}}",
    "block_specific_requests": "{{parameters.blockSpecificRequests}}",
    "blur_selector": "{{parameters.blurSelector}}",
    "remove_selector": "{{parameters.removeSelector}}",
    "result_file_name": "{{parameters.resultFileName}}",
    "scrolling_screenshot": "{{parameters.scrollingScreenshot}}",
    "scroll_speed": "{{parameters.scrollSpeed}}",
    "scroll_back": "{{parameters.scrollBack}}",
    "start_immediately": "{{parameters.startImmediately}}",
    "multiple_scrolling": "{{parameters.multipleScrolling}}",
    "sizes": "{{parameters.sizes}}",
    "duration": "{{parameters.duration}}",
    "fail_on_error": "{{parameters.failOnError}}",
    "longitude": "{{parameters.longitude}}",
    "latitude": "{{parameters.latitude}}",
    "proxy": "{{parameters.proxy}}",
    "headers": "{{parameters.headers}}",
    "cookies": "{{parameters.cookies}}",
    "scroll_to_element": "{{parameters.scrollToElement}}",
    "selector": "{{parameters.selector}}",
    "selector_to_click": "{{parameters.selectorToClick}}",
    "click_recursion": "{{parameters.clickRecursion}}",
    "user_agent": "{{parameters.userAgent}}",
    "accept_languages": "{{parameters.acceptLanguages}}",
    "scroll_delay": "{{parameters.scrollDelay}}",
    "custom_html": "{{parameters.customHtml}}",
    "image_quality": "{{parameters.imageQuality}}",
    "extract_markdown": "{{parameters.extractMarkdown}}",
    "get_image_urls": "{{parameters.getImageUrls}}"
  },
  "response": {
    "type": "binary",
    "output": {
      "name": "{{ifempty(parameters.resultFileName, 'screenshot')}}",
      "data": "{{body}}"
    }
  }
}
