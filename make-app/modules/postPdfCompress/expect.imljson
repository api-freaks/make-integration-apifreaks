[
  {
    "name": "fileId",
    "label": "File ID",
    "type": "text",
    "required": false,
    "help": "The unique ID of a PDF file already uploaded to the API Freaks server. Use this as an alternative to uploading a new file."
  },
  {
    "name": "output",
    "label": "Output",
    "type": "text",
    "required": false,
    "help": "Name of the output PDF."
  },
  {
    "name": "compressionLevel",
    "label": "Compression level",
    "type": "select",
    "required": true,
    "help": "Controls how aggressively the PDF is compressed. Lower levels preserve more quality, while higher levels reduce file size more.",
    "options": [
      {
        "label": "low",
        "value": "low"
      },
      {
        "label": "balanced",
        "value": "balanced"
      },
      {
        "label": "high",
        "value": "high"
      },
      {
        "label": "extreme",
        "value": "extreme"
      }
    ]
  },
  {
    "name": "destroy",
    "label": "Destroy",
    "type": "boolean",
    "required": false,
    "help": "If set to true, the input file(s) will be deleted from the server immediately after the output is generated."
  },
  {
    "name": "webhookUrl",
    "label": "Webhook URL",
    "type": "text",
    "required": false,
    "help": "The URL to which the webhook notification will be sent after the task is completed."
  },
  {
    "name": "webhookFailureNotification",
    "label": "Webhook failure notification",
    "type": "boolean",
    "required": false,
    "help": "If true, a notification will also be sent by email in case the webhook request fails all the retries. The email notification will be sent to the requesting user or their organization’s admin if part of one."
  },
  {
    "name": "XWebhookAuthorization",
    "label": "X webhook authorization",
    "type": "text",
    "required": false,
    "help": "Optional custom header for webhook requests. Format: `Key:Value` (e.g., `Authorization:Bearer token123`). This will be sent as an HTTP header in the webhook call."
  },
  {
    "name": "fileName",
    "label": "File name",
    "type": "filename",
    "required": false,
    "semantic": "file:name",
    "help": "Name of the file being uploaded."
  },
  {
    "name": "fileData",
    "label": "File",
    "type": "buffer",
    "required": false,
    "semantic": "file:data",
    "help": "The file to process. Leave empty to use a previously uploaded file referenced by File ID."
  }
]
