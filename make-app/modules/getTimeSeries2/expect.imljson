[
  {
    "name": "startDate",
    "label": "Startdate",
    "type": "text",
    "required": true,
    "help": "Starting date for the data in YYYY-MM-DD format. Historical dates must be past dates only. Current or future dates are not allowed for historical data. Data available from 1940 onwards. For precision=daily, the difference between endDate and startDate must not exceed 90 days. For precision=hourly, the difference must not exceed 7 days."
  },
  {
    "name": "endDate",
    "label": "Enddate",
    "type": "text",
    "required": true,
    "help": "End date for the data in YYYY-MM-DD format. Historical dates must be past dates only. Current or future dates are not allowed for historical data. Data available from 1940 onwards. For precision=daily, the difference between endDate and startDate must not exceed 90 days. For precision=hourly, the difference must not exceed 7 days."
  },
  {
    "name": "location",
    "label": "Location",
    "type": "text",
    "required": false,
    "help": "City name, place name, or full address."
  },
  {
    "name": "lat",
    "label": "Lat",
    "type": "number",
    "required": false,
    "help": "Latitude of the location."
  },
  {
    "name": "long",
    "label": "Long",
    "type": "number",
    "required": false,
    "help": "Longitude of the location."
  },
  {
    "name": "ip",
    "label": "Ip",
    "type": "text",
    "required": false,
    "help": "IP(v4 or v6) address for location inference."
  },
  {
    "name": "precision",
    "label": "Precision",
    "type": "select",
    "required": false,
    "help": "Precision of the data.",
    "options": [
      {
        "label": "daily",
        "value": "daily"
      },
      {
        "label": "hourly",
        "value": "hourly"
      }
    ]
  },
  {
    "name": "timezone",
    "label": "Timezone",
    "type": "text",
    "required": false,
    "help": "Timezone for the results."
  }
]
