    "label": "Start date",
    "type": "text",
    "required": true,
    "help": "Start date in `YYYY-MM-DD` format."
  },
  {
    "name": "endDate",
    "label": "End date",
    "type": "text",
    "required": false,
    "help": "End date in `YYYY-MM-DD` format. Defaults to yesterday."
  },
  {
    "name": "base",
    "label": "Base",
    "type": "text",
    "required": false,
    "help": "Base currency code. Defaults to `USD`."
  },
  {
    "name": "symbols",
    "label": "Symbols",
    "type": "text",
    "required": false,
    "help": "Comma-separated currency codes. Omit to get all available rates."
  }
]
