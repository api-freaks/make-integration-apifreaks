{
  "url": "/v1.0/swift-code/finder",
  "method": "GET",
  "qs": {
    "country": "{{parameters.country}}",
    "bank": "{{parameters.bank}}",
    "city": "{{parameters.city}}"
  },
  "response": {
    "iterate": "{{body}}",
    "output": {
      "value": "{{item}}"
    },
    "limit": "{{parameters.limit}}"
  }
}
