{
  "url": "/v1.0/ip/security",
  "method": "POST",
  "body": {
    "ips": "{{parameters.ips}}"
  },
  "qs": {
    "fields": "{{parameters.fields}}",
    "excludes": "{{parameters.excludes}}"
  },
  "response": {
    "iterate": "{{body}}",
    "output": "{{item}}",
    "limit": "{{parameters.limit}}"
  }
}
