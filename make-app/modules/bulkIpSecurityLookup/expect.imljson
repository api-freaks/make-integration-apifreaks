[
  {
    "name": "fields",
    "label": "Fields",
    "type": "text",
    "required": false,
    "help": "Comma-separated list of fields to return. Supports dot notation (e.g. security.threat_score)."
  },
  {
    "name": "excludes",
    "label": "Excludes",
    "type": "text",
    "required": false,
    "help": "Comma-separated list of fields to remove from the response. Supports dot notation (e.g. security.is_tor)."
  },
  {
    "name": "ips",
    "label": "IP addresses",
    "type": "array",
    "required": true,
    "help": "List of IP addresses to lookup"
  },
  {
    "name": "limit",
    "label": "Limit",
    "type": "uinteger",
    "default": 10,
    "help": "Maximum number of results to return."
  }
]
