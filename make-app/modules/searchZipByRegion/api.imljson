{
  "url": "/v1.0/zipcode/search/region",
  "method": "GET",
  "qs": {
    "country": "{{parameters.country}}",
    "region": "{{parameters.region}}"
  },
  "response": {
    "iterate": "{{body.codes}}",
    "output": {
      "value": "{{item}}"
    },
    "limit": "{{parameters.limit}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.current_page < body.total_pages}}"
  }
}
