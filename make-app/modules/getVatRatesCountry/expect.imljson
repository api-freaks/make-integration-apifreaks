[
  {
    "name": "format",
    "label": "Format",
    "type": "select",
    "required": false,
    "help": "Specify the desired response format. Options: 'json' (default) or 'xml'.",
    "options": [
      {
        "label": "json",
        "value": "json"
      },
      {
        "label": "xml",
        "value": "xml"
      }
    ]
  },
  {
    "name": "country",
    "label": "Country",
    "type": "text",
    "required": true,
    "help": "Country identifier in Alpha-2 (PK), Alpha-3 (PAK), or full name (Pakistan). Combine with the optional \"state\" query for sub-national VAT; values are case-insensitive and may use underscores instead of spaces."
  },
  {
    "name": "state",
    "label": "State",
    "type": "text",
    "required": false,
    "help": "Optional state or region in Alpha-2 (NY) or full name (New_York). Use with \"country\" for state-level VAT; values are case-insensitive and may use underscores."
  }
]
