    "startDate": "{{parameters.startDate}}",
    "endDate": "{{parameters.endDate}}",
    "base": "{{parameters.base}}",
    "symbols": "{{parameters.symbols}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
