{
  "url": "/v1.0/timezone/converter",
  "method": "GET",
  "qs": {
    "time": "{{parameters.time}}",
    "tz_from": "{{parameters.tzFrom}}",
    "tz_to": "{{parameters.tzTo}}",
    "lat_from": "{{parameters.latFrom}}",
    "long_from": "{{parameters.longFrom}}",
    "lat_to": "{{parameters.latTo}}",
    "long_to": "{{parameters.longTo}}",
    "location_from": "{{parameters.locationFrom}}",
    "location_to": "{{parameters.locationTo}}",
    "iata_from": "{{parameters.iataFrom}}",
    "iata_to": "{{parameters.iataTo}}",
    "icao_from": "{{parameters.icaoFrom}}",
    "icao_to": "{{parameters.icaoTo}}",
    "locode_from": "{{parameters.locodeFrom}}",
    "locode_to": "{{parameters.locodeTo}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
