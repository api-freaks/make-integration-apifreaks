    "type": "text",
    "required": false,
    "help": "IPv4 or IPv6 address to extract timezone information."
  },
  {
    "name": "tz",
    "label": "Tz",
    "type": "text",
    "required": false,
    "help": "Timezone name (e.g., \"Asia/Kolkata\") to retrieve information directly."
  },
  {
    "name": "location",
    "label": "Location",
    "type": "text",
    "required": false,
    "help": "Location string (preferably city and country) to extract timezone."
  },
