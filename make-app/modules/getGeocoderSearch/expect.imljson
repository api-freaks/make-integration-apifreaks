[
  {
    "name": "query",
    "label": "Query",
    "type": "text",
    "required": true,
    "help": "Free-form search query, e.g. Wembley Stadium, London"
  },
  {
    "name": "limit",
    "label": "Limit",
    "type": "number",
    "required": false,
    "help": "Max number of results to return (1–40). May return fewer if matches are weak."
  },
  {
    "name": "minLat",
    "label": "Min latitude",
    "type": "number",
    "required": false,
    "help": "Minimum latitude for the viewbox. Must be ≤ max_lat and between -90 and 90."
  },
  {
    "name": "maxLat",
    "label": "Max latitude",
    "type": "number",
    "required": false,
    "help": "Maximum latitude for the viewbox. Must be ≥ min_lat and between -90 and 90."
  },
  {
    "name": "minLon",
    "label": "Min lon",
    "type": "number",
    "required": false,
    "help": "Minimum longitude for the viewbox. Must be ≤ max_lon and between -180 and 180."
  },
  {
    "name": "maxLon",
    "label": "Max lon",
    "type": "number",
    "required": false,
    "help": "Maximum longitude for the viewbox. Must be ≥ min_lon and between -180 and 180."
  },
  {
    "name": "AcceptLanguage",
    "label": "Accept language",
    "type": "text",
    "required": false,
    "help": "Preferred language order for showing search results. This may either be a simple comma-separated list of language codes or a single entry. The results will be in the 1st language which is matched from the header. As a fallback if the results are not supported in the given language, 'en' will be used."
  }
]
