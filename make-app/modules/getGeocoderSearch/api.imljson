{
  "url": "/v1.0/geocoder/search",
  "method": "GET",
  "qs": {
    "query": "{{parameters.query}}",
    "limit": "{{parameters.limit}}",
    "min_lat": "{{parameters.minLat}}",
    "max_lat": "{{parameters.maxLat}}",
    "min_lon": "{{parameters.minLon}}",
    "max_lon": "{{parameters.maxLon}}"
  },
  "headers": {
    "Accept-Language": "{{parameters.AcceptLanguage}}"
  },
  "response": {
    "iterate": "{{body}}",
    "output": "{{item}}",
    "limit": "{{parameters.limit}}"
  }
}
