[
  {
    "name": "location",
    "label": "Location",
    "type": "text",
    "required": false,
    "help": "Extract astronomy information using location (preferably city)"
  },
  {
    "name": "lat",
    "label": "Latitude",
    "type": "number",
    "required": false,
    "help": "Latitude to extract astronomy information using location coordinates"
  },
  {
    "name": "long",
    "label": "Longitude",
    "type": "number",
    "required": false,
    "help": "Longitude to extract astronomy information using location coordinates"
  },
  {
    "name": "ip",
    "label": "IP",
    "type": "text",
    "required": false,
    "help": "IPv4 or IPv6 address to extract astronomy information using IP address"
  },
  {
    "name": "lang",
    "label": "Language",
