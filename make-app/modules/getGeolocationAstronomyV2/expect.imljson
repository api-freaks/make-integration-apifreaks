  {
    "name": "date",
    "label": "Date",
    "type": "text",
    "required": false,
    "help": "Specific date (format YYYY-MM-DD) for which astronomy data is required"
  },
  {
    "name": "elevation",
    "label": "Elevation",
    "type": "number",
    "required": false,
    "help": "Elevation above sea level at the location, in meters. The value should be between 0 meter and a maximum value of 10,000 meters. Negative value is set to 0."
  },
  {
    "name": "timeZone",
    "label": "Time zone",
    "type": "text",
    "required": false,
    "help": "Time zone to receive all time-based data in your preferred local time."
  }
