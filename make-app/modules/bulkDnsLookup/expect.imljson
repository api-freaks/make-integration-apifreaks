[
  {
    "name": "type",
    "label": "Type",
    "type": "text",
    "required": true,
    "help": "A comma-separated list of DNS record types for lookup. Possible values: A, AAAA, MX, NS, SOA, SPF, TXT, CNAME, or all"
  },
  {
    "name": "domainNames",
    "label": "Domain names",
    "type": "array",
    "required": true,
    "help": "List of hostnames to lookup DNS records for"
  },
  {
    "name": "ipAddresses",
    "label": "IP addresses",
    "type": "array",
    "required": false,
    "help": "Array of IP addresses to include in the lookup for enrichment"
  }
]
