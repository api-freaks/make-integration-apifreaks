[
  {
    "name": "format",
    "label": "Format",
    "type": "select",
    "required": false,
    "help": "Format of the response.",
    "options": [
      {
        "label": "json",
        "value": "json"
      },
      {
        "label": "xml",
        "value": "xml"
      }
    ]
  },
  {
    "name": "host-name",
    "label": "Host Name",
    "type": "text",
    "required": false,
    "help": "Hostname or URL whose DNS records are required."
  },
  {
    "name": "ipAddress",
    "label": "Ipaddress",
    "type": "text",
    "required": false,
    "help": "The IP address for requested DNS's PTR record. 'type' parameter must be set to 'all'."
  },
  {
    "name": "type",
    "label": "Type",
    "type": "text",
    "required": true,
    "help": "A comma-separated list of DNS record types for lookup. Possible values: A, AAAA, MX, NS, SOA, SPF, TXT, CNAME, or all. When ipAddress is provided, type must be \"all\"."
  }
]
