[
  {
    "name": "format",
    "label": "Format",
    "type": "select",
    "required": false,
    "help": "Specifies the desired format for the API response. Choose 'json' for a JSON object. If not provided, the API defaults to JSON format.",
    "options": [
      {
        "label": "json",
        "value": "json"
      }
    ]
  },
  {
    "name": "number",
    "label": "Number",
    "type": "text",
    "required": true,
    "help": "Phone number to validate. Accepts international format (+14155552671), local format (4155552671) with region, or IDD format (0014155552671) with dialer_region."
  },
  {
    "name": "region",
    "label": "Region",
    "type": "text",
    "required": false,
    "help": "Two-letter ISO country code (e.g., US, GB). Required when number is in local format without + prefix. Cannot be used together with dialer_region."
  },
  {
    "name": "dialer_region",
    "label": "Dialer Region",
    "type": "text",
    "required": false,
    "help": "Two-letter ISO country code indicating the country the number is being dialed from. Required when number uses IDD exit code. Cannot be used together with region."
  }
]
