{
  "url": "/v1.0/weather/flood",
  "method": "GET",
  "qs": {
    "startDate": "{{parameters.startDate}}",
    "endDate": "{{parameters.endDate}}",
    "location": "{{parameters.location}}",
    "lat": "{{parameters.lat}}",
    "long": "{{parameters.long}}",
    "ip": "{{parameters.ip}}",
    "timezone": "{{parameters.timezone}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
