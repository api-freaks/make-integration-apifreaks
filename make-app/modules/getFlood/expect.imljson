[
  {
    "name": "startDate",
    "label": "Startdate",
    "type": "text",
    "required": true,
    "help": "Starting date for flood forecast data in YYYY-MM-DD format. Forecast dates must be current or future dates only. Past dates are not allowed for forecast data. The difference between endDate and startDate must not exceed 16 days."
  },
  {
    "name": "endDate",
    "label": "Enddate",
    "type": "text",
    "required": true,
    "help": "End date for flood forecast data in YYYY-MM-DD format. Forecast dates must be current or future dates only. Past dates are not allowed for forecast data. The difference between endDate and startDate must not exceed 16 days."
  },
  {
    "name": "location",
    "label": "Location",
    "type": "text",
    "required": false,
    "help": "City name, place name, or full address."
  },
  {
    "name": "lat",
    "label": "Lat",
    "type": "number",
    "required": false,
    "help": "Latitude of the location."
  },
  {
    "name": "long",
    "label": "Long",
    "type": "number",
    "required": false,
    "help": "Longitude of the location."
  },
  {
    "name": "ip",
    "label": "Ip",
    "type": "text",
    "required": false,
    "help": "IP(v4 or v6) address for location inference."
  },
  {
    "name": "timezone",
    "label": "Timezone",
    "type": "text",
    "required": false,
    "help": "Timezone for the results."
  }
