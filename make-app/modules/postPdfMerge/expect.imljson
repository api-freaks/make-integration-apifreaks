[
  {
    "name": "format",
    "label": "Format",
    "type": "select",
    "required": false,
    "help": "Specifies the desired format for the API response. Choose 'json' for a JSON object or 'xml' for an XML structure.",
    "options": [
      {
        "label": "json",
        "value": "json"
      },
      {
        "label": "xml",
        "value": "xml"
      }
    ]
  },
  {
    "name": "file_id",
    "label": "File Id",
    "type": "array",
    "required": false,
    "help": "An array of unique file IDs referencing PDF files previously uploaded to the API Freaks server. Use this parameter to merge existing files without re-uploading them. Provide multiple IDs to merge files in the specified order."
  },
  {
    "name": "destroy",
    "label": "Destroy",
    "type": "boolean",
    "required": false,
    "help": "If set to `true`, the input file(s) will be permanently deleted from the server immediately after the output PDF is generated."
  },
  {
    "name": "output",
    "label": "Output",
    "type": "text",
    "required": false,
    "help": "Specifies the desired name for the resulting merged PDF file. If not provided, a default name will be assigned."
  },
  {
    "name": "webhook_url",
    "label": "Webhook Url",
    "type": "text",
    "required": false,
    "help": "The URL to which the webhook notification will be sent after the task is completed."
  },
  {
    "name": "webhook_failure_notification",
    "label": "Webhook Failure Notification",
    "type": "boolean",
    "required": false,
    "help": "If true, a notification will also be sent by email in case the webhook request fails all the retries.  The email notification will be sent to the requesting user or their organization’s admin if part of one."
  },
  {
    "name": "X-Webhook-Authorization",
    "label": "X Webhook Authorization",
    "type": "text",
    "required": false,
    "help": "Optional custom header for webhook requests. Format: `Key:Value` (e.g., `Authorization:Bearer token123`). This will be sent as an HTTP header in the webhook call."
  },
  {
    "name": "file",
    "label": "File",
    "type": "array",
    "required": false,
    "help": "The PDF file(s) to be processed. If this parameter is not provided, you must specify `file_id` to use previously uploaded files."
  }
]
