{
  "url": "/v1.0/pdf/merge",
  "method": "POST",
  "body": {
    "file": {
      "value": "{{parameters.fileData}}",
      "options": {
        "filename": "{{parameters.fileName}}"
      }
    }
  },
  "type": "multipart/form-data",
  "qs": {
    "file_id": "{{parameters.fileId}}",
    "destroy": "{{parameters.destroy}}",
    "output": "{{parameters.output}}",
    "webhook_url": "{{parameters.webhookUrl}}",
    "webhook_failure_notification": "{{parameters.webhookFailureNotification}}"
  },
  "headers": {
    "X-Webhook-Authorization": "{{parameters.XWebhookAuthorization}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
