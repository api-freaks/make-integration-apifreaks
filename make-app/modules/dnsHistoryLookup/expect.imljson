[
  {
    "name": "hostName",
    "label": "Host name",
    "type": "text",
    "required": true,
    "help": "Hostname or URL whose historical DNS records are required"
  },
  {
    "name": "type",
    "label": "Type",
    "type": "text",
    "required": true,
    "help": "A comma-separated list of DNS record types for lookup. Possible values: A, AAAA, MX, NS, SOA, SPF, TXT, CNAME, or all"
  },
  {
    "name": "limit",
    "label": "Limit",
    "type": "uinteger",
    "default": 10,
    "help": "Maximum number of results to return."
  }
]
