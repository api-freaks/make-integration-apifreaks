{
  "url": "/v1.0/domain/dns/history",
  "method": "GET",
  "qs": {
    "host-name": "{{parameters.hostName}}",
    "type": "{{parameters.type}}"
  },
  "response": {
    "iterate": "{{body.historicalDnsRecords}}",
    "output": "{{item}}",
    "limit": "{{parameters.limit}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.currentPage < body.totalPages}}"
  }
}
