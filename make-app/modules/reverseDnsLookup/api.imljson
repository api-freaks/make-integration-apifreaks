{
  "url": "/v1.0/domain/dns/reverse",
  "method": "GET",
  "qs": {
    "type": "{{parameters.type}}",
    "value": "{{parameters.value}}",
    "exact": "{{parameters.exact}}"
  },
  "response": {
    "iterate": "{{body.reverseDnsRecords}}",
    "output": "{{item}}",
    "limit": "{{parameters.limit}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.currentPage < body.totalPages}}"
  }
}
