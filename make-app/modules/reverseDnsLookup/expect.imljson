[
  {
    "name": "type",
    "label": "Type",
    "type": "select",
    "required": true,
    "help": "The type of reverse DNS lookup to perform. Determines how the value parameter is interpreted: - A: IPv4 CIDR block - AAAA: IPv6 CIDR block - MX: Mail provider domain - NS: Name server provider hostname - SOA: SOA record admin domain - SPF/TXT: Target verification strings - CNAME: Target hostname",
    "options": [
      {
        "label": "A",
        "value": "A"
      },
      {
        "label": "AAAA",
        "value": "AAAA"
      },
      {
        "label": "MX",
        "value": "MX"
      },
      {
        "label": "NS",
        "value": "NS"
      },
      {
        "label": "SOA",
        "value": "SOA"
      },
      {
        "label": "SPF",
        "value": "SPF"
      },
      {
        "label": "TXT",
        "value": "TXT"
      },
      {
        "label": "CNAME",
        "value": "CNAME"
      }
    ]
  },
  {
    "name": "value",
    "label": "Value",
    "type": "text",
    "required": true,
    "help": "Provide an IP or CIDR for A/AAAA lookups, or a hostname/selector for MX, NS, SOA, SPF, TXT, and CNAME queries. Wildcard regex patterns are also supported (e.g., mail.google.com, m*.google.com, _spf.g*.com, s*.g*.com)."
  },
  {
    "name": "exact",
    "label": "Exact",
    "type": "boolean",
    "required": false,
    "help": "Accepts 'true' or 'false'. \"true\" returns only records that exactly match the input (NS, MX, CNAME, SOA, SPF, TXT). \"false\" returns all matches (default when omitted)."
  },
  {
    "name": "limit",
    "label": "Limit",
    "type": "uinteger",
    "default": 10,
    "help": "Maximum number of results to return."
  }
]
