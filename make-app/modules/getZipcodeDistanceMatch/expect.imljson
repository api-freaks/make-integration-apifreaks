[
  {
    "name": "format",
    "label": "Format",
    "type": "select",
    "required": false,
    "help": "Format of the response.",
    "options": [
      {
        "label": "json",
        "value": "json"
      },
      {
        "label": "xml",
        "value": "xml"
      }
    ]
  },
  {
    "name": "codes",
    "label": "Codes",
    "type": "array",
    "required": true,
    "help": "Comma-separated list of postal/zip codes. Maximum 100 values allowed."
  },
  {
    "name": "country",
    "label": "Country",
    "type": "text",
    "required": true,
    "help": "Country code in ISO 3166-1 alpha-2 format."
  },
  {
    "name": "distance",
    "label": "Distance",
    "type": "number",
    "required": false,
    "help": "Maximum allowed distance between postal code pairs."
  },
  {
    "name": "unit",
    "label": "Unit",
    "type": "text",
    "required": false,
    "help": "Supported distance units are m, km, mi, ft, yd, in."
  }
]
