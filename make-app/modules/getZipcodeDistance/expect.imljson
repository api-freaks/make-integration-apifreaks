  {
    "name": "format",
    "label": "Format",
    "type": "select",
    "required": false,
    "help": "Format of the response.",
    "options": [
      {
        "label": "json",
        "value": "json"
      },
      {
        "label": "xml",
        "value": "xml"
      }
