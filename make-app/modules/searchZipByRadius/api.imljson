{
  "url": "/v1.0/zipcode/search/radius",
  "method": "GET",
  "qs": {
    "format": "{{parameters.format}}",
    "code": "{{parameters.code}}",
    "lat": "{{parameters.lat}}",
    "long": "{{parameters.long}}",
    "country": "{{parameters.country}}",
    "radius": "{{parameters.radius}}",
    "unit": "{{parameters.unit}}",
    "page": "{{parameters.page}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
